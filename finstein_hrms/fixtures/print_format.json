  "html": "<style>\n    body {\n        font-family: Arial, sans-serif;\n        color: #333;\n    }\n\n    .wrapper {\n        padding: 40px;\n        max-width: 800px;\n        margin: auto;\n    }\n\n    /* ─── Header ─── */\n    .header {\n        text-align: center;\n        border-bottom: 3px solid #d32f2f;\n        padding-bottom: 15px;\n        margin-bottom: 25px;\n    }\n\n    .company-name {\n        font-size: 34px;\n        font-weight: bold;\n        color: #d32f2f;\n        letter-spacing: 3px;\n    }\n\n    .company-sub {\n        font-size: 12px;\n        color: #888;\n        margin-top: 4px;\n    }\n\n    .letter-title {\n        text-align: center;\n        font-size: 18px;\n        font-weight: bold;\n        text-transform: uppercase;\n        text-decoration: underline;\n        color: #d32f2f;\n        letter-spacing: 1px;\n        margin: 20px 0;\n    }\n\n    /* ─── Meta Info ─── */\n    .meta-info {\n        display: flex;\n        justify-content: space-between;\n        font-size: 13px;\n        color: #555;\n        margin-bottom: 20px;\n    }\n\n    /* ─── Info Box ─── */\n    .info-box {\n        background: #fff5f5;\n        border-left: 4px solid #d32f2f;\n        padding: 12px 16px;\n        border-radius: 4px;\n        margin-bottom: 20px;\n        font-size: 13px;\n        line-height: 2.0;\n    }\n\n    .info-box strong {\n        color: #d32f2f;\n    }\n\n    /* ─── Section Title ─── */\n    .section-title {\n        font-size: 14px;\n        font-weight: bold;\n        color: #d32f2f;\n        border-left: 4px solid #d32f2f;\n        padding-left: 10px;\n        margin: 20px 0 12px 0;\n    }\n\n    /* ─── Activities Table ─── */\n    .activity-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 25px;\n        font-size: 13px;\n    }\n\n    .activity-table th {\n        background-color: #d32f2f;\n        color: white;\n        padding: 10px 14px;\n        text-align: left;\n    }\n\n    .activity-table td {\n        padding: 9px 14px;\n        border: 1px solid #ddd;\n        vertical-align: top;\n        line-height: 1.6;\n    }\n\n    .activity-table tr:nth-child(even) {\n        background-color: #fff5f5;\n    }\n\n    /* ─── Status Badge ─── */\n    .status-badge {\n        display: inline-block;\n        padding: 3px 14px;\n        border-radius: 20px;\n        font-size: 12px;\n        font-weight: bold;\n    }\n\n    .status-pending {\n        background: #fff3cd;\n        border: 1px solid #ffc107;\n        color: #856404;\n    }\n\n    .status-approved {\n        background: #d4edda;\n        border: 1px solid #28a745;\n        color: #155724;\n    }\n\n    .status-rejected {\n        background: #f8d7da;\n        border: 1px solid #dc3545;\n        color: #721c24;\n    }\n\n    /* ─── Exit Summary ─── */\n    .summary-box {\n        background: #f9f9f9;\n        border: 1px solid #ddd;\n        padding: 14px 16px;\n        border-radius: 4px;\n        font-size: 13px;\n        line-height: 1.8;\n        margin-bottom: 25px;\n    }\n\n    /* ─── Confidential Badge ─── */\n    .confidential-badge {\n        display: inline-block;\n        background: #fff3cd;\n        border: 1px solid #ffc107;\n        color: #856404;\n        padding: 3px 14px;\n        border-radius: 20px;\n        font-size: 11px;\n        margin-bottom: 15px;\n    }\n\n    /* ─── Signature ─── */\n    .signature-section {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 50px;\n        font-size: 13px;\n    }\n\n    .signature-box {\n        width: 30%;\n    }\n\n    .signature-line {\n        border-top: 1px solid #333;\n        margin-top: 40px;\n        margin-bottom: 6px;\n    }\n\n    .signature-label {\n        font-weight: bold;\n        font-size: 13px;\n    }\n\n    .signature-sub {\n        color: #666;\n        font-size: 12px;\n        margin-top: 3px;\n    }\n\n    /* ─── Footer ─── */\n    .footer {\n        margin-top: 40px;\n        border-top: 2px solid #d32f2f;\n        padding-top: 12px;\n        text-align: center;\n        font-size: 11px;\n        color: #888;\n    }\n</style>\n\n<div class=\"wrapper\">\n\n    <!-- ─── Header ─── -->\n    <div class=\"header\">\n        <div class=\"company-name\">FINSTEIN</div>\n        <div class=\"company-sub\">Excellence in Every Step | HR Department</div>\n    </div>\n\n    <div class=\"confidential-badge\">🔒 Private & Confidential</div>\n\n    <!-- ─── Title ─── -->\n    <div class=\"letter-title\">Employee Separation Letter</div>\n\n    <!-- ─── Ref & Date ─── -->\n    <div class=\"meta-info\">\n        <span><strong>Ref No:</strong> {{ doc.name }}</span>\n        <span><strong>Date:</strong> {{ frappe.format(doc.separation_begins_on, {'fieldtype': 'Date'}) }}</span>\n    </div>\n\n    <!-- ─── Employee Info ─── -->\n    <div class=\"info-box\">\n        <strong>Employee Details</strong><br>\n        <strong>Employee ID &nbsp;&nbsp;&nbsp;:</strong> {{ doc.employee }}<br>\n        <strong>Employee Name :</strong> {{ doc.employee_name }}<br>\n        <strong>Company &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:</strong> {{ doc.company }}<br>\n        <strong>Department &nbsp;&nbsp;&nbsp;:</strong> {{ doc.department or \"—\" }}<br>\n        <strong>Designation &nbsp;&nbsp;:</strong> {{ doc.designation or \"—\" }}<br>\n        <strong>Separation Date:</strong> {{ frappe.format(doc.separation_begins_on, {'fieldtype': 'Date'}) }}<br>\n        <strong>Status &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:</strong>\n        {% if doc.workflow_state == \"Approved\" %}\n            <span class=\"status-badge status-approved\">✅ Approved</span>\n        {% elif doc.workflow_state == \"Rejected\" %}\n            <span class=\"status-badge status-rejected\">❌ Rejected</span>\n        {% else %}\n            <span class=\"status-badge status-pending\">⏳ {{ doc.workflow_state or doc.status }}</span>\n        {% endif %}\n    </div>\n\n    <!-- ─── Reason ─── -->\n    {% if doc.reason %}\n    <div class=\"section-title\">📝 Reason for Separation</div>\n    <div class=\"summary-box\">\n        {{ doc.reason }}\n    </div>\n    {% endif %}\n\n    <!-- ─── Separation Activities ─── -->\n    {% if doc.activities %}\n    <div class=\"section-title\">📋 Separation Activities Checklist</div>\n    <table class=\"activity-table\">\n        <thead>\n            <tr>\n                <th>No.</th>\n                <th>Activity</th>\n                <th>Assigned To</th>\n                <th>Begin On (Days)</th>\n                <th>Duration (Days)</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for activity in doc.activities %}\n            <tr>\n                <td>{{ loop.index }}</td>\n                <td>{{ activity.activity_name }}</td>\n                <td>{{ activity.user or \"—\" }}</td>\n                <td>{{ activity.begin_on or 0 }}</td>\n                <td>{{ activity.duration or 0 }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    {% endif %}\n\n    <!-- ─── Exit Interview Summary ─── -->\n    {% if doc.exit_interview_summary %}\n    <div class=\"section-title\">💬 Exit Interview Summary</div>\n    <div class=\"summary-box\">\n        {{ doc.exit_interview_summary }}\n    </div>\n    {% endif %}\n\n    <!-- ─── Closing ─── -->\n    <div style=\"font-size:14px; line-height:1.8; margin-bottom:20px; text-align:justify;\">\n        This letter confirms the separation of <strong>{{ doc.employee_name }}</strong>\n        from <strong>Finstein</strong> effective\n        <strong>{{ frappe.format(doc.separation_begins_on, {'fieldtype': 'Date'}) }}</strong>.\n        We thank the employee for their contributions and wish them the very best\n        in their future endeavors.\n    </div>\n\n    <!-- ─── Signatures ─── -->\n    <div class=\"signature-section\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\"></div>\n            <div class=\"signature-label\">Employee</div>\n            <div class=\"signature-sub\">{{ doc.employee_name }}</div>\n            <div class=\"signature-sub\">Date: ___________</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\"></div>\n            <div class=\"signature-label\">HR Manager</div>\n            <div class=\"signature-sub\">Finstein</div>\n            <div class=\"signature-sub\">Date: ___________</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\"></div>\n            <div class=\"signature-label\">Head</div>\n            <div class=\"signature-sub\">Finstein</div>\n            <div class=\"signature-sub\">Date: ___________</div>\n        </div>\n    </div>\n\n    <!-- ─── Footer ─── -->\n    <div class=\"footer\">\n        <strong>Finstein</strong> | HR Department<br>\n        This document is confidential and intended solely for authorized personnel.\n    </div>\n\n</div>",
