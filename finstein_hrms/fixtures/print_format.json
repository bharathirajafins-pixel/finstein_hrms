  "html": "<style>\n    body {\n        font-family: Arial, sans-serif;\n        color: #333;\n    }\n\n    .wrapper {\n        padding: 40px;\n        max-width: 800px;\n        margin: auto;\n    }\n\n    /* ─── Header ─── */\n    .header {\n        text-align: center;\n        border-bottom: 3px solid #1a73e8;\n        padding-bottom: 15px;\n        margin-bottom: 25px;\n    }\n\n    .company-name {\n        font-size: 34px;\n        font-weight: bold;\n        color: #1a73e8;\n        letter-spacing: 3px;\n    }\n\n    .company-sub {\n        font-size: 12px;\n        color: #888;\n        margin-top: 4px;\n    }\n\n    .letter-title {\n        text-align: center;\n        font-size: 18px;\n        font-weight: bold;\n        text-transform: uppercase;\n        text-decoration: underline;\n        color: #1a73e8;\n        letter-spacing: 1px;\n        margin: 20px 0;\n    }\n\n    /* ─── Meta Info ─── */\n    .meta-info {\n        display: flex;\n        justify-content: space-between;\n        font-size: 13px;\n        color: #555;\n        margin-bottom: 20px;\n    }\n\n    /* ─── Candidate Info Box ─── */\n    .candidate-box {\n        background: #f0f6ff;\n        border-left: 4px solid #1a73e8;\n        padding: 12px 16px;\n        border-radius: 4px;\n        margin-bottom: 20px;\n        font-size: 13px;\n        line-height: 1.9;\n    }\n\n    .candidate-box strong {\n        color: #1a73e8;\n    }\n\n    /* ─── Intro Text ─── */\n    .intro-text {\n        font-size: 14px;\n        line-height: 1.8;\n        margin-bottom: 25px;\n        text-align: justify;\n    }\n\n    /* ─── Section Title ─── */\n    .section-title {\n        font-size: 14px;\n        font-weight: bold;\n        color: #1a73e8;\n        border-left: 4px solid #1a73e8;\n        padding-left: 10px;\n        margin-bottom: 12px;\n    }\n\n    /* ─── Offer Terms Table ─── */\n    .offer-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 25px;\n        font-size: 13px;\n    }\n\n    .offer-table th {\n        background-color: #1a73e8;\n        color: white;\n        padding: 10px 14px;\n        text-align: left;\n    }\n\n    .offer-table td {\n        padding: 9px 14px;\n        border: 1px solid #ddd;\n        vertical-align: top;\n        line-height: 1.6;\n    }\n\n    .offer-table tr:nth-child(even) {\n        background-color: #f5f9ff;\n    }\n\n    .offer-table td:first-child {\n        font-weight: bold;\n        width: 30%;\n        background-color: #eef4ff;\n        color: #333;\n    }\n\n    /* ─── Terms & Conditions ─── */\n    .tc-box {\n        background: #fffbf0;\n        border: 1px solid #ffc107;\n        padding: 14px 16px;\n        border-radius: 4px;\n        font-size: 13px;\n        line-height: 1.8;\n        margin-bottom: 25px;\n    }\n\n    /* ─── Closing ─── */\n    .closing-text {\n        font-size: 14px;\n        line-height: 1.8;\n        margin-bottom: 30px;\n        text-align: justify;\n    }\n\n    /* ─── Signature ─── */\n    .signature-section {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 50px;\n        font-size: 13px;\n    }\n\n    .signature-box {\n        width: 45%;\n    }\n\n    .signature-line {\n        border-top: 1px solid #333;\n        margin-top: 40px;\n        margin-bottom: 6px;\n    }\n\n    .signature-label {\n        font-weight: bold;\n        font-size: 13px;\n    }\n\n    .signature-sub {\n        color: #666;\n        font-size: 12px;\n        margin-top: 3px;\n    }\n\n    /* ─── Badge ─── */\n    .confidential-badge {\n        display: inline-block;\n        background: #fff3cd;\n        border: 1px solid #ffc107;\n        color: #856404;\n        padding: 3px 14px;\n        border-radius: 20px;\n        font-size: 11px;\n        margin-bottom: 15px;\n    }\n\n    /* ─── Footer ─── */\n    .footer {\n        margin-top: 40px;\n        border-top: 2px solid #1a73e8;\n        padding-top: 12px;\n        text-align: center;\n        font-size: 11px;\n        color: #888;\n    }\n</style>\n\n<div class=\"wrapper\">\n\n    <!-- ─── Header ─── -->\n    <div class=\"header\">\n        <div class=\"company-name\">FINSTEIN</div>\n        <div class=\"company-sub\">Excellence in Every Step | HR Department</div>\n    </div>\n\n    <div class=\"confidential-badge\">🔒 Private & Confidential</div>\n\n    <!-- ─── Title ─── -->\n    <div class=\"letter-title\">Job Offer Letter</div>\n\n    <!-- ─── Ref & Date ─── -->\n    <div class=\"meta-info\">\n        <span><strong>Ref No:</strong> {{ doc.name }}</span>\n        <span><strong>Date:</strong> {{ frappe.format(doc.offer_date, {'fieldtype': 'Date'}) }}</span>\n    </div>\n\n    <!-- ─── Candidate Info ─── -->\n    <div class=\"candidate-box\">\n        <strong>To,</strong><br>\n        <strong>Name &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:</strong> {{ doc.applicant_name }}<br>\n        <strong>Email &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:</strong> {{ doc.applicant_email }}<br>\n        <strong>Position &nbsp;:</strong> {{ doc.designation }}<br>\n        <strong>Company &nbsp;:</strong> {{ doc.company }}\n    </div>\n\n    <!-- ─── Introduction ─── -->\n    <div class=\"intro-text\">\n        Dear <strong>{{ doc.applicant_name }}</strong>,<br><br>\n        We are delighted to extend this offer of employment to you for the position of\n        <strong>{{ doc.designation }}</strong> at <strong>Finstein</strong>.\n        After careful consideration, we are confident that your skills and experience\n        make you an excellent fit for our team.<br><br>\n        Please review the following terms of your offer carefully.\n    </div>\n\n    <!-- ─── Offer Terms ─── -->\n    {% if doc.job_offer_terms %}\n    <div class=\"section-title\">📋 Offer Terms</div>\n    <table class=\"offer-table\">\n        <thead>\n            <tr>\n                <th>Offer Term</th>\n                <th>Value / Description</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for term in doc.job_offer_terms %}\n            <tr>\n                <td>{{ term.offer_term }}</td>\n                <td>\n                    {{\n                        term.value\n                        | replace(\"{{ designation }}\", doc.designation or \"\")\n                        | replace(\"{{ applicant_name }}\", doc.applicant_name or \"\")\n                        | replace(\"{{ offer_date }}\", frappe.format(doc.offer_date, {'fieldtype': 'Date'}) or \"\")\n                        | replace(\"{{ date_of_joining }}\", frappe.format(doc.offer_date, {'fieldtype': 'Date'}) or \"\")\n                        | replace(\"{{ gross_salary }}\", \"As Per Discussion\")\n                        | replace(\"{{ department }}\", doc.designation or \"\")\n                    }}\n                </td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    {% endif %}\n\n    <!-- ─── Terms & Conditions ─── -->\n    {% if doc.terms_and_conditions %}\n    <div class=\"section-title\">📜 Terms & Conditions</div>\n    <div class=\"tc-box\">\n        {{ doc.terms_and_conditions }}\n    </div>\n    {% endif %}\n\n    <!-- ─── Closing ─── -->\n    <div class=\"closing-text\">\n        This offer is valid for <strong>7 days</strong> from the date of issue.\n        Please sign and return a copy of this letter as your acceptance within the validity period.\n        Failure to respond will result in automatic withdrawal of this offer.<br><br>\n        We look forward to welcoming you to the <strong>Finstein</strong> family.\n        Wishing you a successful and rewarding career with us.\n    </div>\n\n    <!-- ─── Signatures ─── -->\n    <div class=\"signature-section\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\"></div>\n            <div class=\"signature-label\">Authorized Signatory</div>\n            <div class=\"signature-sub\">HR Manager — Finstein</div>\n            <div class=\"signature-sub\">Date: _______________</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\"></div>\n            <div class=\"signature-label\">Candidate Acceptance</div>\n            <div class=\"signature-sub\">Name: {{ doc.applicant_name }}</div>\n            <div class=\"signature-sub\">Date: _______________</div>\n        </div>\n    </div>\n\n    <!-- ─── Footer ─── -->\n    <div class=\"footer\">\n        <strong>Finstein</strong> | HR Department<br>\n        This document is confidential and intended solely for {{ doc.applicant_name }}.\n    </div>\n\n</div>",
