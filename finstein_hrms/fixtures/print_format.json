  "html": "<style>\n    body {\n        font-family: Arial, sans-serif;\n        color: #333;\n    }\n\n    .letter-wrapper {\n        padding: 40px;\n        max-width: 800px;\n        margin: auto;\n    }\n\n    /* ─── Header ─── */\n    .header {\n        text-align: center;\n        border-bottom: 3px solid #1a73e8;\n        padding-bottom: 15px;\n        margin-bottom: 30px;\n    }\n\n    .company-name {\n        font-size: 32px;\n        font-weight: bold;\n        color: #1a73e8;\n        letter-spacing: 2px;\n    }\n\n    .company-tagline {\n        font-size: 13px;\n        color: #888;\n        margin-top: 4px;\n    }\n\n    .letter-title {\n        text-align: center;\n        font-size: 18px;\n        font-weight: bold;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n        margin: 20px 0;\n        text-decoration: underline;\n        color: #1a73e8;\n    }\n\n    /* ─── Date & Ref ─── */\n    .meta-info {\n        display: flex;\n        justify-content: space-between;\n        font-size: 13px;\n        margin-bottom: 20px;\n        color: #555;\n    }\n\n    /* ─── Body ─── */\n    .salutation {\n        font-size: 14px;\n        margin-bottom: 15px;\n    }\n\n    .intro-text {\n        font-size: 14px;\n        line-height: 1.8;\n        margin-bottom: 25px;\n        text-align: justify;\n    }\n\n    /* ─── Terms Table ─── */\n    .terms-title {\n        font-size: 15px;\n        font-weight: bold;\n        margin-bottom: 10px;\n        color: #1a73e8;\n        border-left: 4px solid #1a73e8;\n        padding-left: 10px;\n    }\n\n    .terms-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 25px;\n        font-size: 13px;\n    }\n\n    .terms-table th {\n        background-color: #1a73e8;\n        color: white;\n        padding: 10px 12px;\n        text-align: left;\n    }\n\n    .terms-table td {\n        padding: 9px 12px;\n        border: 1px solid #ddd;\n        vertical-align: top;\n        line-height: 1.6;\n    }\n\n    .terms-table tr:nth-child(even) {\n        background-color: #f5f9ff;\n    }\n\n    .terms-table td:first-child {\n        font-weight: bold;\n        width: 30%;\n        color: #333;\n        background-color: #eef4ff;\n    }\n\n    /* ─── Closing ─── */\n    .closing-text {\n        font-size: 14px;\n        line-height: 1.8;\n        margin-bottom: 30px;\n        text-align: justify;\n    }\n\n    /* ─── Signature ─── */\n    .signature-section {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 50px;\n        font-size: 13px;\n    }\n\n    .signature-box {\n        width: 45%;\n    }\n\n    .signature-line {\n        border-top: 1px solid #333;\n        margin-bottom: 6px;\n        margin-top: 40px;\n    }\n\n    .signature-label {\n        font-weight: bold;\n        font-size: 13px;\n    }\n\n    .signature-sub {\n        color: #666;\n        font-size: 12px;\n    }\n\n    /* ─── Footer ─── */\n    .footer {\n        margin-top: 40px;\n        border-top: 2px solid #1a73e8;\n        padding-top: 12px;\n        text-align: center;\n        font-size: 11px;\n        color: #888;\n    }\n\n    .confidential-badge {\n        display: inline-block;\n        background: #fff3cd;\n        border: 1px solid #ffc107;\n        color: #856404;\n        padding: 3px 12px;\n        border-radius: 20px;\n        font-size: 11px;\n        margin-bottom: 15px;\n    }\n</style>\n\n<div class=\"letter-wrapper\">\n\n    <!-- ─── Company Header ─── -->\n    <div class=\"header\">\n        <div class=\"company-name\">FINSTEIN</div>\n        <div class=\"company-tagline\">Excellence in Every Step | HR Department</div>\n    </div>\n\n    <div class=\"confidential-badge\">🔒 Private & Confidential</div>\n\n    <!-- ─── Letter Title ─── -->\n    <div class=\"letter-title\">Appointment Letter</div>\n\n    <!-- ─── Date & Ref ─── -->\n    <div class=\"meta-info\">\n        <span><strong>Ref No:</strong> {{ doc.name }}</span>\n        <span><strong>Date:</strong> {{ frappe.format(doc.appointment_date, {'fieldtype': 'Date'}) }}</span>\n    </div>\n\n    <!-- ─── Introduction ─── -->\n<div class=\"intro-text\">\n    Dear <strong>{{ doc.applicant_name }}</strong>,<br><br>\n\n    We are pleased to inform you that you have been selected for the position of\n    <strong>{{ doc.job_applicant }}</strong> at <strong>Finstein</strong>.\n\n    This appointment is effective from\n    <strong>{{ frappe.format(doc.appointment_date, {'fieldtype': 'Date'}) }}</strong>.\n\n    We welcome you to the Finstein family and look forward to your valuable\n    contributions to our organization. We are confident that your skills and\n    experience will be a great asset to our team.\n</div>\n\n    <!-- ─── Terms & Conditions ─── -->\n\n\n\n    <!-- ─── Acceptance Line ─── -->\n    <div class=\"closing-text\">\n        Please sign and return a copy of this letter as your acceptance of the above\n        terms and conditions within <strong>3 working days</strong> from the date of receipt.\n        We wish you a successful and rewarding career with <strong>Finstein</strong>.\n    </div>\n\n    <!-- ─── Signature Section ─── -->\n    <div class=\"signature-section\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\"></div>\n            <div class=\"signature-label\">Authorized Signatory</div>\n            <div class=\"signature-sub\">HR Manager — Finstein</div>\n            <div class=\"signature-sub\">\n    Date: _______________\n</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\"></div>\n            <div class=\"signature-label\">Employee Acceptance</div>\n            <div class=\"signature-sub\">Name: {{ doc.applicant_name }}</div>\n            <div class=\"signature-sub\">Date: _______________</div>\n        </div>\n    </div>\n\n    <!-- ─── Footer ─── -->\n    <div class=\"footer\">\n        <strong>Finstein</strong> | HR Department<br>\n        This document is confidential and intended solely for the named recipient.\n    </div>\n\n</div>",
